FROM alpine AS base

ARG BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=${BUN_RUNTIME_TRANSPILER_CACHE_PATH}

RUN apk add --no-cache \
    bash \
    ca-certificates \
    curl \
    git \
    libgcc \
    libstdc++ \
    openssh-client \
    ripgrep

FROM base AS build-amd64
COPY dist/opencode-linux-x64-baseline-musl/bin/opencode /usr/local/bin/opencode

FROM base AS build-arm64
COPY dist/opencode-linux-arm64-musl/bin/opencode /usr/local/bin/opencode

ARG TARGETARCH
FROM build-${TARGETARCH}

ARG VERSION
LABEL org.opencontainers.image.title="opencode remote workspace" \
      org.opencontainers.image.description="Beta opencode build for remote Linux workspaces" \
      org.opencontainers.image.source="https://github.com/OpeOginni/opencode" \
      org.opencontainers.image.version=${VERSION}

WORKDIR /workspace
EXPOSE 4096

RUN opencode --version

ENTRYPOINT ["opencode"]
CMD ["serve", "--hostname", "0.0.0.0", "--port", "4096"]
