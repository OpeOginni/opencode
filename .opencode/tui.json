{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": [
    [
      "./plugins/tui-smoke.tsx",
      {
        "enabled": false,
        "label": "workspace",
        "keybinds": {
          "smoke_modal": "ctrl+alt+m",
          "smoke_screen": "ctrl+alt+o",
          "smoke_screen_home": "escape,ctrl+shift+h",
          "smoke_screen_modal": "ctrl+alt+m",
          "smoke_dialog_close": "escape,q"
        }
      }
    ],
    [
      "./plugins/search-messages.tsx",
      {
        "enabled": true,
        "keybinds": {
          "search_open": "ctrl+f",
          "search_next": "down,enter,ctrl+n",
          "search_prev": "up,ctrl+p",
          "search_close": "escape"
        }
      }
    ]
  ]
}
